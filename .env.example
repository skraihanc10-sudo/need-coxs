DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="need-coxs-dev-secret-change-in-production"

# Production (Coolify): DATABASE_URL=file:/data/needcoxs.db, AUTH_URL=https://your-domain, AUTH_TRUST_HOST=true
# Uploads live next to the database (/data/uploads). Override with UPLOAD_DIR=.

# SMS for real OTPs. Leave unset for the demo code 123456.
# SMS_PROVIDER=demo

# Payment gateways (record-only until set).
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# NAGAD_MERCHANT_ID=
# NAGAD_PUBLIC_KEY=
# NAGAD_PRIVATE_KEY=

# Hide the demo logins box on /login
# SHOW_DEMO_LOGINS=0
# Turn the rate limiter off (tests only)
# RATE_LIMIT=off
